# ---- TruthGuard configuration (all optional; defaults run fully offline) ----
# LLM_MODE: offline (deterministic agents, no keys) | live (real providers) | replay (cached responses only)
LLM_MODE=offline
# Fallback chain across providers that have keys (+ local Ollama)
LLM_PROVIDERS=["groq","gemini","ollama"]
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Models per role (provider/model). Keep the critic on a different family from the synthesizer.
PLANNER_MODEL=groq/llama-3.1-8b-instant
EXTRACT_MODEL=groq/llama-3.1-8b-instant
SYNTH_MODEL=gemini/gemini-2.0-flash
CRITIC_MODEL=groq/llama-3.3-70b-versatile

# Storage: SQLite for a laptop quick start, PostgreSQL (+pgvector) in compose
DATABASE_URL=sqlite+aiosqlite:///./truthguard.db
VECTOR_BACKEND=numpy

# Optional heavier models (pip install -e "backend[models]")
EMBED_BACKEND=hashing
RERANK_BACKEND=lexical
NLI_BACKEND=heuristic

# API
API_KEY=
CORS_ORIGINS=["http://localhost:3000"]

# Demo: pin "today" so the scripted answers never drift, and warm caches at startup
DEMO_MODE=false
TODAY_OVERRIDE=
